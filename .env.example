# ============================================================
# AAELink — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# --- App ---
APP_ENV=development           # development | production
APP_VERSION=0.1.0

# --- Ports (local dev) ---
PORT_FRONTEND=80
PORT_TRAEFIK_DASHBOARD=8080
PORT_GRAFANA=3000
PORT_PROMETHEUS=9090
PORT_MAILHOG=8025
PORT_MINIO_CONSOLE=9001

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aaelink
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB_AUTH=aaelink_auth
POSTGRES_DB_TICKET=aaelink_tickets

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- NATS ---
NATS_URL=nats://nats:4222

# --- MinIO (object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_dev_only
MINIO_USE_SSL=false
MINIO_BUCKET_ATTACHMENTS=aaelink-attachments

# --- JWT ---
JWT_SECRET=change_me_dev_only_32_chars_min!!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Email (local dev uses Mailhog) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AAELink <aaelinkapp@aae.co.th>
SMTP_TLS=false

# --- Email (Microsoft 365 — use in production/NAS2New) ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=aaelinkapp@aae.co.th
# SMTP_PASS=your_app_password_here
# SMTP_FROM=AAELink <aaelinkapp@aae.co.th>
# SMTP_TLS=true

# --- File Upload ---
MAX_FILE_SIZE_MB=100
MAX_TOTAL_SIZE_MB=500

# --- Auth Service ---
AUTH_SERVICE_PORT=8001

# --- Ticket Service ---
TICKET_SERVICE_PORT=8002

# --- Notify Service ---
NOTIFY_SERVICE_PORT=8003

# --- Media Service ---
MEDIA_SERVICE_PORT=8004

# --- i18n ---
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,th,de
