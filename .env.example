MATTERMOST_URL=http://localhost:8065
MATTERMOST_WS_URL=ws://localhost:8065/api/v4/websocket
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CHANNEL_ID=

# Same PostgreSQL database as Mattermost compose service (schema: aaelink).
DATABASE_URL=postgres://mattermost:mattermost@127.0.0.1:25432/mattermost

# MinIO (S3-compatible) for document storage. Console: http://localhost:29001
S3_ENDPOINT=http://127.0.0.1:29000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aaelink-documents
S3_REGION=us-east-1

STIRLING_URL=http://localhost:28085
