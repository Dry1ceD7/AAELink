NEXT_PUBLIC_APP_URL=http://localhost:3040
# Other devices on your Wi‑Fi: set to http://<this-mac-ip>:3040 or run `npm run dev:wifi:auto` (same as dev:host / dev:lan:auto; see .env.lan.example).
# HTTPS dev on LAN: `npm run dev:wifi:https` sets https://<ip>:3040 automatically. Optional mkcert: export AAELINK_HTTPS_KEY=... AAELINK_HTTPS_CERT=... (and AAELINK_HTTPS_CA) before that script.
# Optional dev-only: extra hostnames for Next.js allowedDevOrigins (comma or space). Usually unnecessary if NEXT_PUBLIC_APP_URL matches the URL PCs use.
# NEXT_ALLOWED_DEV_HOSTS=192.168.1.10

# Shown on Sign in and Request access (optional). Plain text for staff only.
NEXT_PUBLIC_AAELINK_IT_PHONE=
NEXT_PUBLIC_AAELINK_IT_EMAIL=
NEXT_PUBLIC_AAELINK_IT_LIVE_CHAT_URL=

# HTTPS (dev or prod): when NEXT_PUBLIC_APP_URL is https://..., session cookies use Secure. Desktop lab flag for self-signed: AAELINK_DESKTOP_TRUST_DEV_TLS=1 (see docs/LAN-DESKTOP-CLIENTS.md).
# Production over HTTPS: set NEXT_PUBLIC_APP_URL to https://... so session cookies use Secure.
# If you must use http in production (LAN), leave URL as http:// or omit; optional force: AAELINK_SESSION_COOKIE_SECURE=1

# IT contact OTP (email via Resend, or SMS via Twilio). For local dev without Resend: AAELINK_OTP_LOG_TO_STDOUT=1 prints codes to server logs.
# AAELINK_OTP_LOG_TO_STDOUT=1
# AAELINK_RESEND_API_KEY=
# AAELINK_RESEND_FROM=AAELink <onboarding@example.com>
# AAELINK_TWILIO_ACCOUNT_SID=
# AAELINK_TWILIO_AUTH_TOKEN=
# AAELINK_TWILIO_FROM=

# PostgreSQL (Compose maps 25432; schema `aaelink` is created on startup).
DATABASE_URL=postgres://aaelink:aaelink@127.0.0.1:25432/aaelink

# CSRF signing secret. REQUIRED in production. The runtime refuses to start
# without it (audit-2026-05-26 CRIT-001 — the prior hard-coded fallback was
# committed to the repo and let any reader forge valid CSRF tokens).
# Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dev mode (NODE_ENV !== 'production') uses an ephemeral per-process secret
# when this is unset — sessions across a dev-server restart need a refresh.
# CSRF_SECRET=

# 0 = internal use: new accounts only via IT admin (or first bootstrap user). 1 = allow self-service register when empty or per product rules.
AAELINK_OPEN_REGISTRATION=0

# MinIO (S3-compatible) for document storage. Console: http://localhost:29001
S3_ENDPOINT=http://127.0.0.1:29000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aaelink-documents
S3_REGION=us-east-1

STIRLING_URL=http://localhost:28085

# One-shot platform super-admin (see docs/LAN-DESKTOP-CLIENTS.md). Do not commit real passwords.
# AAELINK_SEED_ADMIN_PASSWORD=
# AAELINK_SEED_ADMIN_EMAIL=adminaaelink@aae.co.th
# AAELINK_SEED_ADMIN_USERNAME=adminaaelink

# Redis (optional, single-node deployments). REQUIRED for any deployment running
# more than one Next.js node behind a load balancer — without it, real-time
# events published on node A are invisible on node B because each node owns a
# private in-process EventEmitter. The runtime uses `ioredis` lazily; install
# the `ioredis` package as a project dependency in production. On connection
# failure the runtime falls back to an in-process MemoryPubSub with a one-time
# warning so the app still starts.
# REDIS_URL=redis://127.0.0.1:6379

# WebSocket gateway (optional). When set, clients prefer the WS transport;
# otherwise SSE is used. The gateway service is shipped separately from the
# Next.js app and runs as a sidecar — see `app/api/ws/route.ts` for the
# negotiated handshake.
# WS_GATEWAY_URL=wss://ws.aaelink.example.com

# Public mirror of WS_GATEWAY_URL for the browser. Without this set, the
# in-tree home shell uses SSE (the v0.0.34–v0.0.37 replay store stays dark).
# When set, `app/home/page.tsx` opens a WebSocket to the gateway, sends
# subscribe(channel, since=cursor) on every reconnect, and receives replay
# events for the disconnect window.
# NEXT_PUBLIC_WS_GATEWAY_URL=wss://ws.aaelink.example.com/ws
