# AAELink environment for Docker Desktop Kubernetes backend
# Copy to .env and adjust as needed.
# Deploys all infra in K8s; only Next.js runs on the host.

NEXT_PUBLIC_APP_URL=http://localhost:3040

# PostgreSQL — exposed from K8s as a NodePort would need additional config.
# For dev: keep using docker-compose Postgres on 25432, or port-forward K8s Postgres:
#   kubectl port-forward -n mattermost svc/postgres 25432:5432
DATABASE_URL=postgres://mattermost:mattermost-dev-2026@127.0.0.1:30432/aaelink?sslmode=disable

AAELINK_OPEN_REGISTRATION=1

# MinIO — K8s NodePort 30900/30901
S3_ENDPOINT=http://127.0.0.1:30900
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aaelink-documents
S3_REGION=us-east-1

# Stirling PDF — K8s NodePort 30885
STIRLING_URL=http://127.0.0.1:30885

# Platform admin (used by scripts/seed-platform-admin.ts)
AAELINK_SEED_ADMIN_EMAIL=adminaaelink@aae.co.th
AAELINK_SEED_ADMIN_USERNAME=adminaaelink
AAELINK_SEED_ADMIN_PASSWORD=Adminaaelink2026
