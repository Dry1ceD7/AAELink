# Optional copy for stable LAN testing: save as `.env.lan` and merge lines into `.env`,
# or skip files entirely and use: npm run dev:lan:auto
#
# Public origin must match the URL phones and other PCs type in the browser (not localhost).

NEXT_PUBLIC_APP_URL=http://REPLACE_WITH_YOUR_LAN_IP:3040

# Keep the rest of your normal .env (database, S3, etc.) in `.env`; only the line above
# needs to change per machine or Wi‑Fi session.
