{
  "annotations": { "list": [] },
  "description": "AAELink Enterprise Platform — Observability Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Request Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(aaelink_http_requests_total[5m])", "legendFormat": "req/s" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] } } }
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "aaelink_error_rate_percent", "legendFormat": "errors %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } }
    },
    {
      "title": "Avg Latency (ms)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "aaelink_avg_latency_ms", "legendFormat": "avg latency" }],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 }] } } }
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "aaelink_uptime_seconds", "legendFormat": "uptime" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "HTTP Requests Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "rate(aaelink_http_requests_total[5m])", "legendFormat": "Total Requests" },
        { "expr": "rate(aaelink_http_errors_total[5m])", "legendFormat": "Errors" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 } } }
    },
    {
      "title": "Route Latency Distribution (P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "aaelink_route_latency_p95_ms", "legendFormat": "{{method}} {{route}}" }],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } }
    },
    {
      "title": "Database Connection Pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "aaelink_db_connections_total", "legendFormat": "Total" },
        { "expr": "aaelink_db_connections_idle", "legendFormat": "Idle" },
        { "expr": "aaelink_db_connections_waiting", "legendFormat": "Waiting" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } } } }
    },
    {
      "title": "Platform Entities",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "aaelink_users_total", "legendFormat": "Users" },
        { "expr": "aaelink_messages_total", "legendFormat": "Messages" },
        { "expr": "aaelink_channels_total", "legendFormat": "Channels" },
        { "expr": "aaelink_workspaces_total", "legendFormat": "Workspaces" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "blue", "value": null }] } } }
    },
    {
      "title": "Top Routes by Request Count",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [{ "expr": "topk(20, aaelink_route_requests_total)", "legendFormat": "{{method}} {{route}}", "format": "table", "instant": true }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "Requests", "__name__": "Metric" } } }]
    },
    {
      "title": "Route Error Heatmap",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [{ "expr": "rate(aaelink_route_errors_total[5m])", "legendFormat": "{{method}} {{route}}" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }, "color": { "mode": "palette-classic" } } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["aaelink", "enterprise", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AAELink Enterprise Dashboard",
  "uid": "aaelink-enterprise-v1",
  "version": 1,
  "weekStart": ""
}
