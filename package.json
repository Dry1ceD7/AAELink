{
  "name": "aaelink-clean",
  "version": "0.0.17-alpha",
  "private": true,
  "scripts": {
    "dev": "zsh scripts/dev-lan-https-auto.zsh",
    "dev:localhost": "next dev -p 3040",
    "dev:lan": "zsh scripts/dev-lan.zsh",
    "dev:lan:auto": "zsh scripts/dev-lan-auto.zsh",
    "dev:host": "zsh scripts/dev-lan-auto.zsh",
    "dev:wifi": "zsh scripts/dev-lan-auto.zsh",
    "dev:wifi:auto": "zsh scripts/dev-lan-auto.zsh",
    "dev:wifi:https": "zsh scripts/dev-lan-https-auto.zsh",
    "dev:host:https": "zsh scripts/dev-lan-https-auto.zsh",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start -p 3040 -H 0.0.0.0",
    "start:wifi": "next start -p 3040 -H 0.0.0.0",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "release:build": "npm run lint && npm run type-check && npm run build",
    "seed:platform-admin": "npx tsx scripts/seed-platform-admin.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "bootstrap:local": "zsh scripts/bootstrap-local.zsh",
    "desktop:install": "npm ci --prefix desktop",
    "desktop:start": "npm run start --prefix desktop",
    "desktop:start:lan": "zsh scripts/desktop-start-lan.zsh",
    "desktop:start:wifi": "zsh scripts/desktop-start-lan.zsh",
    "desktop:start:wifi:https": "zsh scripts/desktop-start-lan-https.zsh",
    "desktop:start:branded": "npm run start:branded --prefix desktop",
    "desktop:icons": "npm run icons:sync --prefix desktop",
    "desktop:build:mac": "npm run desktop:install && npm run dist:mac --prefix desktop",
    "desktop:build:win": "npm run desktop:install && npm run dist:win --prefix desktop",
    "worker": "npx tsx lib/worker.ts",
    "worker:dev": "npx tsx --watch lib/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:chromium": "playwright test --project=chromium"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-mention": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "^1.11.0",
    "next": "^16.2.4",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tiptap-markdown": "^0.9.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.2.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
