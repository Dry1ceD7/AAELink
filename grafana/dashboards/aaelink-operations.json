{
  "annotations": { "list": [] },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate (req/min)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(aaelink_http_requests_total[1m])) * 60",
          "legendFormat": "Total"
        },
        {
          "expr": "sum(rate(aaelink_http_requests_total{status=~\"5..\"}[1m])) * 60",
          "legendFormat": "5xx Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 2,
      "title": "API Latency (P50/P95/P99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(aaelink_http_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(aaelink_http_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(aaelink_http_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      }
    },
    {
      "id": 3,
      "title": "Error Rate by Route",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "topk(20, sum by (route, method) (rate(aaelink_http_requests_total{status=~\"4..|5..\"}[5m])) / sum by (route, method) (rate(aaelink_http_requests_total[5m])) * 100)",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "custom.displayMode", "value": "color-background" }, { "id": "thresholds", "value": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } }] }
        ]
      }
    },
    {
      "id": 4,
      "title": "Job Queue Depth",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "rawSql": "SELECT now() as time, status, COUNT(*)::int as count FROM aaelink.jobs GROUP BY status",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "id": 5,
      "title": "Webhook v2 Deliveries",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*)::int as total, COUNT(*) FILTER (WHERE status = 'delivered')::int as delivered, COUNT(*) FILTER (WHERE status = 'failed')::int as failed FROM aaelink.webhook_deliveries_v2 WHERE created_at > extract(epoch from now() - interval '24 hours') * 1000"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } }
      }
    },
    {
      "id": 6,
      "title": "Webhook Delivery Latency",
      "type": "gauge",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "targets": [
        {
          "rawSql": "SELECT AVG(latency_ms)::int as avg_ms, percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms)::int as p95_ms FROM aaelink.webhook_deliveries_v2 WHERE created_at > extract(epoch from now() - interval '1 hour') * 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 200 }, { "color": "red", "value": 1000 }] }
        }
      }
    },
    {
      "id": 7,
      "title": "DLP Violations (24h)",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*)::int as violations FROM aaelink.dlp_violations WHERE detected_at > extract(epoch from now() - interval '24 hours') * 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] }
        }
      }
    },
    {
      "id": 8,
      "title": "Active Sessions",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "targets": [
        {
          "rawSql": "SELECT COUNT(DISTINCT user_id)::int as active_users FROM aaelink.sessions WHERE expires_at > extract(epoch from now()) * 1000"
        }
      ]
    },
    {
      "id": 9,
      "title": "Audit Log Activity (7d)",
      "type": "barchart",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "rawSql": "SELECT to_timestamp(created_at / 1000)::date as time, action, COUNT(*)::int as count FROM aaelink.audit_logs WHERE created_at > extract(epoch from now() - interval '7 days') * 1000 GROUP BY time, action ORDER BY time"
        }
      ]
    },
    {
      "id": 10,
      "title": "Workflow Executions",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "rawSql": "SELECT to_timestamp(started_at / 1000)::date as time, status, COUNT(*)::int as count FROM aaelink.workflow_executions WHERE started_at > extract(epoch from now() - interval '7 days') * 1000 GROUP BY time, status ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 11,
      "title": "Top Routes by Request Volume",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "topk(15, sum by (route) (increase(aaelink_http_requests_total[1h])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "continuous-blues" } }
      }
    },
    {
      "id": 12,
      "title": "System Health",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "process_uptime_seconds", "legendFormat": "Uptime" },
        { "expr": "process_resident_memory_bytes / 1024 / 1024", "legendFormat": "Memory (MB)" },
        { "expr": "nodejs_active_handles_total", "legendFormat": "Active Handles" },
        { "expr": "nodejs_eventloop_lag_seconds", "legendFormat": "Event Loop Lag" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["aaelink", "enterprise", "api", "observability"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "DS_POSTGRES",
        "type": "datasource",
        "query": "postgres"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "AAELink — Operations Dashboard",
  "uid": "aaelink-ops-v1",
  "version": 1
}
